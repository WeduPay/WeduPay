# Keep the waitlist disabled until legal, retention, and operational readiness checks are complete.
WAITLIST_ENABLED=false
WAITLIST_ALLOWED_ORIGIN=https://example.com

# Server-only Supabase credentials. Never expose the service-role key to browsers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Upstash Redis REST credentials for server-side rate limiting.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-server-only-token
